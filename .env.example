PORT=3000
NODE_ENV=development

# PostgreSQL — same database as onix_ingester
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379

# JWT secrets (min 32 characters each)
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars

# Token lifetimes
ACCESS_TOKEN_TTL=900        # 15 minutes in seconds
REFRESH_TOKEN_TTL=2592000   # 30 days in seconds

# Firebase Admin SDK — from Firebase Console > Project Settings > Service Accounts > Generate new private key
#
# Preferred: base64-encode the whole downloaded JSON into a single variable.
#   base64 -i serviceAccountKey.json
# Use this form anywhere the value is typed or pasted into a dashboard (Render,
# CI secrets). A raw PEM key does not survive those fields intact — stray
# quotes or flattened newlines produce an opaque OpenSSL "DECODER routines::
# unsupported" error at startup. Base64 has nothing a form can mangle.
FIREBASE_SERVICE_ACCOUNT_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...
#
# Alternative: the three fields individually. Still supported, and fine in a
# local .env where dotenv handles the quoting. Only used if the base64 variable
# above is unset.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Gemini — same API key as onix_ingester
# GEMINI_EMBEDDING_MODEL must match the model used to embed books in the ingester (default: text-embedding-004)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_FLASH_MODEL=gemini-2.5-flash-lite
# Used only if the primary flash model fails after exhausting retries (e.g. deprecated/unavailable)
GEMINI_FLASH_MODEL_FALLBACK=gemini-2.5-flash

# Guest session lifetime in hours. Default: 72 (24 * 3 = 3 days).
# Set to 168 for a full week, 24 for a single day, etc.
GUEST_SESSION_TTL_HOURS=72

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here
EMAIL_FROM=hello@kinkane.app
EMAIL_FROM_NAME=Kinkane

# Base client URL — the single source of truth for every user-facing link the
# server builds: email CTAs, password reset, Stripe return URLs, and referral
# links (APP_URL/r/CODE/name-slug). Kinkané lives on .app, not .com.
# Use http://localhost:3001 (or whatever port your frontend runs on) in development
APP_URL=https://kinkane.app

# Admin token for the Bull Board dashboard (/admin/queues). Min 32 chars.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=your_admin_token_min_32_chars_here

# Cloudinary cloud name — from your Cloudinary dashboard (top-left account name)
# Used to validate that photo URLs belong to your account, not an arbitrary one
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Gardners Books — I12 Home Delivery (dropship) ordering account. This is the
# FTP account with HOMEORD/HOMEACK/HOMEDISP/HOMEGEN/HOMEPRE directories used
# to place and track customer fulfillment orders — separate from onix_ingester's
# read-only Bespoke Inventory / Generic Data feed accounts. Confirm with
# Gardners (ITServices@gardners.com) whether this shares edi.gardners.com with
# the Bespoke Inventory account or needs its own login before going live.
GARDNERS_DROPSHIP_SFTP_HOST=edi.gardners.com
GARDNERS_DROPSHIP_SFTP_PORT=22
GARDNERS_DROPSHIP_SFTP_USERNAME=your_dropship_ftp_username
GARDNERS_DROPSHIP_SFTP_PASSWORD=your_dropship_ftp_password
# Your 6-character Gardners account code (quoted in every order's HEADER record)
GARDNERS_DROPSHIP_ACCOUNT_CODE=KIN155
# Default value for new orders' HEADER TESTING flag. Gardners acknowledges
# test orders normally but never creates the order lines. Leave true until
# you deliberately want to place a real, fulfilled order.
GARDNERS_DROPSHIP_DEFAULT_TESTING=true

# While NODE_ENV=development, NOTHING is sent to Gardners' Home Delivery SFTP —
# no order file, no ack poll — regardless of the credentials above or of the
# per-order TESTING flag. Local checkouts stop at `paid` with a note on the
# order saying why nothing was submitted.
#
# This exists because running the API locally normally means having real
# Gardners credentials in .env (the catalogue feeds need them), and TESTING=Y is
# not sufficient protection: it is a per-order flag someone can turn off, and it
# still transmits.
#
# Set to true ONLY to send real traffic to the supplier from a dev machine —
# scripts/gardners-dropship-test.ts is the one thing that legitimately needs it.
GARDNERS_DROPSHIP_ALLOW_IN_DEV=false
UNSUBSCRIBE_SECRET=your_unsubscribe_secret_min_32_chars_here
# ── Stripe (Kinkané Plus) ─────────────────────────────────────────────────────
# All optional: without them the server still boots and every non-payment route
# works — the subscription endpoints answer 503 and feature gating (below) can
# still be exercised. Use test-mode keys everywhere except production.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Webhook URL: POST /api/v1/user/subscription/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# The four Prices on the "Kinkané Plus" product.
# Standard: $8.99/month, $79.99/year.
STRIPE_PRICE_PLUS_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_PLUS_ANNUAL=price_your_annual_price_id
# Founding Member launch pricing: $6.99/month, $59.99/year. Charged for the
# subscriber's first term only — the rollover to standard pricing is set up as
# a Stripe subscription schedule when checkout completes.
STRIPE_PRICE_PLUS_MONTHLY_FOUNDING=price_your_monthly_founding_price_id
STRIPE_PRICE_PLUS_ANNUAL_FOUNDING=price_your_annual_founding_price_id

# While NOW() is before this, checkout uses the Founding Member prices. Unset
# (or past) means everyone gets standard pricing. Set to launch date + 3 months.
FOUNDING_OFFER_ENDS_AT=2026-11-01T00:00:00Z

# Where Stripe returns the user. Default to APP_URL-based paths if unset.
STRIPE_CHECKOUT_SUCCESS_URL=https://kinkane.com/account/subscription?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://kinkane.com/account/subscription?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://kinkane.com/account/subscription

# Master switch for Plus feature gating. While false, requirePlus lets every
# request through — the gate ships dark and is turned on (or reverted) here
# without a deploy.
GATING_ENABLED=false

# ── Commerce: cart, checkout and orders ───────────────────────────────────────
# Everything below is policy rather than secret. Shipping is our own pricing
# decision; VAT is external law we can only track. Both are configuration so
# they can change without a deploy. See docs/ecommerce-plan.md.

# ── Where a request's country comes from (SHARED) ─────────────────────────────
# Not commerce-owned: geoService resolves country for referral scoring (frozen
# at signup) and for commerce currency display (resolved live, per request).
# Both read these, which is the point — two independent header lookups would
# eventually disagree about where the same user is.
#
# 1. A trusted proxy header. Cloudflare: cf-ipcountry. Vercel:
#    x-vercel-ip-country. ONLY trustworthy when every request genuinely passes
#    through that proxy — a client can forge any header, so leaving this set
#    while the origin is directly reachable hands users a free currency picker.
#    Unset means "trust no header", which is the safe default.
# 2. A local MaxMind GeoLite2 database, if one is on disk. Needs the optional
#    `maxmind` package; when either is missing the lookup is skipped rather
#    than failing.
#
# Both absent is supported: country resolves to unknown, referrals score
# nothing, and commerce falls back to DEFAULT_CURRENCY.
GEO_COUNTRY_HEADER=cf-ipcountry
MAXMIND_DB_PATH=

# Currencies we present prices in. Keep this list short: every entry is a live
# FX exposure and another rounding surface.
SUPPORTED_CURRENCIES=USD,GBP,EUR
DEFAULT_CURRENCY=USD
CURRENCY_BY_COUNTRY=GB:GBP,IE:EUR,DE:EUR,FR:EUR,ES:EUR,IT:EUR,NL:EUR,BE:EUR,PT:EUR,AT:EUR,FI:EUR,GR:EUR

# Gardners quotes GBP only, so every other currency is a conversion. This static
# table drifts between deploys — the buffer pads the rate so drift eats the
# buffer rather than the margin. Re-check the rates periodically; if FX ever
# moves enough to matter, swap this for a daily-cached rates feed behind the
# same interface.
FX_RATES_FROM_GBP=USD:1.27,EUR:1.17
FX_BUFFER_PERCENT=3

# Shipping in GBP pence, resolved most-specific-first: country -> EU -> ROW.
# Gardners bills us per line, so a flat per-order rate on a big basket is a
# deliberate margin decision — SHIPPING_PER_ITEM_GBP_PENCE is the lever.
SHIPPING_RATES=GB:299,IE:599,EU:699,US:899,ROW:1199
SHIPPING_PER_ITEM_GBP_PENCE=0
# Subtotal (GBP pence) at or above which shipping is free. Unset = never.
SHIPPING_FREE_THRESHOLD_GBP_PENCE=4000

# VAT by destination, as a percentage. Physical books are zero-rated in the UK
# and Ireland, so 0 here is genuinely correct rather than a placeholder. This
# CANNOT express EU OSS thresholds, US sales-tax nexus, or import duty — it is a
# documented stopgap, and Stripe Tax is the replacement when volume justifies it.
# Note that shipping anywhere means some customers get a customs bill at the
# border; that needs disclosure in the checkout UI, not a config value.
VAT_RATES=GB:0,IE:0,US:0
VAT_DEFAULT_RATE_PERCENT=0
# false = tax added on top at checkout. true = the book price already includes
# it, so a non-zero rate comes out of our margin instead of the customer's total.
VAT_PRICES_INCLUDE_TAX=false

# ISO country -> Gardners region code(s) from REGIONS.CSV, pipe-separated where
# a country sits in several (e.g. GH:AFR|WAF). Ships EMPTY: Gardners' region
# vocabulary is its own and a guessed mapping would silently authorise sales
# into territories nobody has checked the rights for. While this is empty, any
# title that HAS market restrictions is blocked from sale; titles with no
# restriction rows (the vast majority) are unaffected.
GARDNERS_REGION_BY_COUNTRY=

# Cart ceilings. This is a bookshop on a home-delivery service, not a trade counter.
CART_MAX_QUANTITY_PER_LINE=10
CART_MAX_ITEMS=20

# Where Stripe returns the buyer after a book order (distinct from the
# subscription checkout URLs above).
STRIPE_ORDER_SUCCESS_URL=https://kinkane.com/orders?checkout=success
STRIPE_ORDER_CANCEL_URL=https://kinkane.com/cart?checkout=cancelled

# ISO country -> the country NAME Gardners expects in ICOUNTRY/DCOUNTRY.
# Overrides and extends the built-in table in
# src/services/commerce/gardners-countries.ts.
#
# ACTION REQUIRED before real orders ship: the authoritative list is NOT in the
# I12 specification PDF. Page 9 points at a separate "I12d FTP Country List.txt"
# and says to request it from ITServices@gardners.com (quote the account
# number). Only UNITED KINGDOM and GHANA are confirmed today — everything else
# in the built-in table is an educated guess. A name Gardners doesn't recognise
# goes to manual review, delays the order, and "for repeat offenders could also
# result in your account being suspended".
#
# Checkout refuses any country with no mapping, so the failure mode is a lost
# sale rather than a stuck order.
#   GARDNERS_COUNTRY_NAMES_EXTRA=US:UNITED STATES OF AMERICA,TR:TURKIYE
GARDNERS_COUNTRY_NAMES_EXTRA=
