PORT=3000
NODE_ENV=development

# PostgreSQL — same database as onix_ingester
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379

# JWT secrets (min 32 characters each)
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars

# Token lifetimes
ACCESS_TOKEN_TTL=900        # 15 minutes in seconds
REFRESH_TOKEN_TTL=2592000   # 30 days in seconds

# Firebase Admin SDK — from Firebase Console > Project Settings > Service Accounts > Generate new private key
#
# Preferred: base64-encode the whole downloaded JSON into a single variable.
#   base64 -i serviceAccountKey.json
# Use this form anywhere the value is typed or pasted into a dashboard (Render,
# CI secrets). A raw PEM key does not survive those fields intact — stray
# quotes or flattened newlines produce an opaque OpenSSL "DECODER routines::
# unsupported" error at startup. Base64 has nothing a form can mangle.
FIREBASE_SERVICE_ACCOUNT_B64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...
#
# Alternative: the three fields individually. Still supported, and fine in a
# local .env where dotenv handles the quoting. Only used if the base64 variable
# above is unset.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Gemini — same API key as onix_ingester
# GEMINI_EMBEDDING_MODEL must match the model used to embed books in the ingester (default: text-embedding-004)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_FLASH_MODEL=gemini-2.5-flash-lite
# Used only if the primary flash model fails after exhausting retries (e.g. deprecated/unavailable)
GEMINI_FLASH_MODEL_FALLBACK=gemini-2.5-flash

# Guest session lifetime in hours. Default: 72 (24 * 3 = 3 days).
# Set to 168 for a full week, 24 for a single day, etc.
GUEST_SESSION_TTL_HOURS=72

# SendGrid — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-api-key-here
EMAIL_FROM=hello@kinkane.com
EMAIL_FROM_NAME=Kinkane

# Frontend base URL — used to build links in emails (e.g. password reset)
# Use http://localhost:3001 (or whatever port your frontend runs on) in development
APP_URL=https://kinkane.com

# Admin token for the Bull Board dashboard (/admin/queues). Min 32 chars.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=your_admin_token_min_32_chars_here

# Cloudinary cloud name — from your Cloudinary dashboard (top-left account name)
# Used to validate that photo URLs belong to your account, not an arbitrary one
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Gardners Books — I12 Home Delivery (dropship) ordering account:
# orders.gardners.com over explicit FTPS ("FTPeS"), confirmed live 2026-08-03.
# Directories are lowercase on the real server (homeord/homeack/homedisp/
# homegen/homepre) even though the spec PDF prints them uppercase. This is a
# different host AND protocol from onix_ingester's Bespoke Inventory SFTP
# account, despite the similar "KIN155FTP"-style username.
GARDNERS_DROPSHIP_FTP_HOST=orders.gardners.com
GARDNERS_DROPSHIP_FTP_PORT=21
GARDNERS_DROPSHIP_FTP_USERNAME=KIN155FTP
GARDNERS_DROPSHIP_FTP_PASSWORD=your_dropship_ftp_password
# Your 6-character Gardners account code (quoted in every order's HEADER record)
GARDNERS_DROPSHIP_ACCOUNT_CODE=KIN155
# Default value for new orders' HEADER TESTING flag. Gardners acknowledges
# test orders normally but never creates the order lines. Leave true until
# you deliberately want to place a real, fulfilled order.
GARDNERS_DROPSHIP_DEFAULT_TESTING=true
UNSUBSCRIBE_SECRET=your_unsubscribe_secret_min_32_chars_here
# ── Stripe (Kinkané Plus) ─────────────────────────────────────────────────────
# All optional: without them the server still boots and every non-payment route
# works — the subscription endpoints answer 503 and feature gating (below) can
# still be exercised. Use test-mode keys everywhere except production.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Webhook URL: POST /api/v1/user/subscription/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# The four Prices on the "Kinkané Plus" product.
# Standard: $8.99/month, $79.99/year.
STRIPE_PRICE_PLUS_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_PLUS_ANNUAL=price_your_annual_price_id
# Founding Member launch pricing: $6.99/month, $59.99/year. Charged for the
# subscriber's first term only — the rollover to standard pricing is set up as
# a Stripe subscription schedule when checkout completes.
STRIPE_PRICE_PLUS_MONTHLY_FOUNDING=price_your_monthly_founding_price_id
STRIPE_PRICE_PLUS_ANNUAL_FOUNDING=price_your_annual_founding_price_id

# While NOW() is before this, checkout uses the Founding Member prices. Unset
# (or past) means everyone gets standard pricing. Set to launch date + 3 months.
FOUNDING_OFFER_ENDS_AT=2026-11-01T00:00:00Z

# Where Stripe returns the user. Default to APP_URL-based paths if unset.
STRIPE_CHECKOUT_SUCCESS_URL=https://kinkane.com/account/subscription?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://kinkane.com/account/subscription?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://kinkane.com/account/subscription

# Master switch for Plus feature gating. While false, requirePlus lets every
# request through — the gate ships dark and is turned on (or reverted) here
# without a deploy.
GATING_ENABLED=false
